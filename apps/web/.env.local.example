# Copy to apps/web/.env.local (gitignored) and fill from the Supabase project.
# Dashboard: Project Settings → API, or the Connect dialog.
#
# Required for `pnpm dev` and Vercel. A `pnpm build` smoke check can use
# placeholder values; production and preview must use real project secrets.

# Project URL (Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Safe to expose in the browser.
# Settings → API → Project API keys → publishable / anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. SERVER ONLY — never prefix with NEXT_PUBLIC_,
# never import from client components, never commit a real value.
# Used by training server actions (apply_training_result_and_checkpoint).
# Settings → API → Project API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin for auth email links and OAuth redirects.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app (or your custom domain)
NEXT_PUBLIC_SITE_URL=
