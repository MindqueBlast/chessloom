# Copy to .env.local and fill these from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server actions only. Never prefix this key with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin used in auth email and OAuth redirects (for example, http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
